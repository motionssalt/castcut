{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/motionssalt/castcut/schemas/scene_production.schema.json",
  "title": "CastCut Scene Production JSON",
  "type": "object",
  "required": ["version", "segments"],
  "additionalProperties": true,
  "properties": {
    "version": {"type": "integer", "const": 1},
    "request": {"type": "string", "description": "Echo of the user's scene request (optional)"},
    "title": {"type": "string"},
    "segments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["start", "end"],
        "additionalProperties": true,
        "properties": {
          "start": {"description": "Segment start: seconds (number) or \"MM:SS\"/\"HH:MM:SS.mmm\" (string)"},
          "end": {"description": "Segment end: same formats as start; must be greater than start"},
          "note": {"type": "string"}
        }
      }
    },
    "metadata": {"type": "object"}
  }
}
