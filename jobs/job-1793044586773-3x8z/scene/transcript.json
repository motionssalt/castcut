    {
      "start": 292.46,
      "end": 293.46,
      "text": "Good."
    },
    {
      "start": 293.46,
      "end": 295.46,
      "text": "I love this."
    },
    {
      "start": 295.46,
      "end": 297.46,
      "text": "Hey, we should probably head back over to my place."
    },
