    {
      "start": 126.7,
      "end": 127.7,
      "text": "You took pictures."
    },
    {
      "start": 127.7,
      "end": 131.7,
      "text": "That'll live on the internet for ever."
    },
    {
      "start": 131.7,
      "end": 132.7,
      "text": "Wouldn't that bad?"
    },
    {
      "start": 132.7,
      "end": 135.04,
