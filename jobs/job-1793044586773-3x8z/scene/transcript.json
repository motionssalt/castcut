    },
    {
      "start": 211.82,
      "end": 215.82,
      "text": "His hands are full of tuna fish salad."
    },
    {
      "start": 215.82,
      "end": 216.82,
      "text": "Now, look down."
    },
    {
      "start": 216.82,
