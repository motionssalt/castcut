    },
    {
      "start": 108.71,
      "end": 110.71,
      "text": "And we all finished our semester projects."
    },
    {
      "start": 110.71,
      "end": 111.71,
      "text": "Everyone pulls in all night."
    },
    {
      "start": 111.71,
      "end": 112.71,
      "text": "Sound the school?"
    },
    {
      "start": 112.71,
      "end": 113.71,
      "text": "Yeah."
    },
    {
      "start": 113.71,
      "end": 114.71,
      "text": "It's kind of fun."
    },
    {
      "start": 114.71,
      "end": 115.71,
      "text": "Yeah, it's fun."
    },
    {
      "start": 115.71,
      "end": 116.71,
      "text": "Unless you're up in the fall sleeping."
    },
    {
      "start": 116.71,
      "end": 118.71,
      "text": "Sam, draw something on your forehead."
    },
    {
      "start": 118.71,
      "end": 121.7,
      "text": "What did she draw on your forehead?"
