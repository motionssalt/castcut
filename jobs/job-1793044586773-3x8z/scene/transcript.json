    {
      "start": 917.1,
      "end": 919.63,
      "text": "Good."
    },
    {
      "start": 919.63,
      "end": 921.63,
      "text": "I'm going to go with my ham and peace."
    },
    {
      "start": 921.63,
      "end": 922.63,
      "text": "You love the Brad."
    },
    {
      "start": 922.63,
      "end": 923.63,
      "text": "Nobody, nobody, boo."
    },
    {
      "start": 923.63,
      "end": 924.63,
      "text": "You can't bury your love and ham."
    },
    {
      "start": 924.63,
      "end": 925.63,
      "text": "We're going to try."
    },
    {
      "start": 925.63,
      "end": 928.74,
      "text": "Do you admit it?"
    },
    {
      "start": 928.74,
      "end": 929.74,
      "text": "Did I?"
    },
    {
      "start": 929.74,
      "end": 930.74,
      "text": "I figured."
