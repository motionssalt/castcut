    },
    {
      "start": 304.46,
      "end": 305.46,
      "text": "Uh-huh."
    },
    {
      "start": 305.46,
      "end": 307.46,
      "text": "You just ordered the pairpad's camera for five seconds."
    },
    {
      "start": 307.46,
      "end": 308.46,
      "text": "And it'll tell you what your mood is."
    },
    {
      "start": 308.46,
      "end": 309.46,
      "text": "Really?"
    },
    {
      "start": 309.46,
      "end": 310.46,
      "text": "That's so cool."
    },
    {
      "start": 310.46,
      "end": 312.46,
