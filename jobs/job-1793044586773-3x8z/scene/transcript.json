    {
      "start": 137.04,
      "end": 141.64,
      "text": "It was a pretty accurate drawing."
    },
    {
      "start": 141.64,
      "end": 146.64,
      "text": "In five, four, three, two."
    },
    {
      "start": 146.64,
      "end": 209.82,
      "text": "Look at us."
    },
    {
      "start": 209.82,
      "end": 210.82,
      "text": "Now, back at Gibby."
