      "start": 985.86,
      "end": 986.86,
      "text": "It's important."
    },
    {
      "start": 986.86,
      "end": 988.86,
      "text": "Help me do this."
    },
    {
      "start": 988.86,
      "end": 989.86,
      "text": "We're Sam."
    },
    {
      "start": 989.86,
      "end": 990.86,
      "text": "All right."
    },
    {
      "start": 990.86,
      "end": 991.86,
      "text": "But if she gets mad at me."
