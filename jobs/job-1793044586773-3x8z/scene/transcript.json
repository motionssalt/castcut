      "start": 299.46,
      "end": 300.46,
      "text": "Sure, let me grab my stuff."
    },
    {
      "start": 300.46,
      "end": 301.46,
      "text": "All right."
    },
    {
      "start": 301.46,
      "end": 302.46,
      "text": "What's your project?"
    },
    {
      "start": 302.46,
      "end": 303.46,
      "text": "We're making an app for the pairpad."
    },
    {
      "start": 303.46,
      "end": 304.46,
