      "text": "Very cool."
    },
    {
      "start": 877.11,
      "end": 878.11,
      "text": "What do you mean?"
    },
    {
      "start": 878.11,
      "end": 882.77,
      "text": "I love ham all of that."
    },
    {
      "start": 882.77,
      "end": 886.02,
      "text": "You can't kiss and snuggle with him."
